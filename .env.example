# Trivia bot secrets — copy this file to .env and fill in real values.
# .env is gitignored so your secrets stay local.

# Anthropic API key for Claude calls
ANTHROPIC_API_KEY=

# Webhook for posting daily intakes to #daily-trivia
DISCORD_WEBHOOK_DAILY=

# Webhook for posting Tuesday compile to #trivia-report
DISCORD_WEBHOOK_WEEKLY=

# Bot credentials for reading message history from #daily-trivia
# (only used by the Tuesday compile)
DISCORD_BOT_TOKEN_DAILY=
DISCORD_DAILY_CHANNEL_ID=
